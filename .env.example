# LLM 配置（内网部署的大模型服务）
LLM_API_KEY=sk-placeholder
LLM_BASE_URL=http://192.168.1.100:8000/v1
LLM_MODEL=qwen2.5-72b-instruct
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.3

# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=false
